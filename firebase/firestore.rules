rules_version = '2';

// LIARHUNT leaderboard rules.
// Paste this into Firebase console > Firestore Database > Rules, then click Publish.
// They allow reading the leaderboard, and block impossible or duplicate scores.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function okName(n) { return n is string && n.size() >= 2 && n.size() <= 16; }
    function okBadge(b) { return b in ['', '🥇', '🥈', '🥉', '🎖️', '🏅']; }
    // A picked face, f00 to f15 (js/engine.js FACES). Optional wherever it appears.
    function okAv(a) { return a is string && a.matches('^f(0[0-9]|1[0-5])$'); }
    function avOk(d) { return !('av' in d) || okAv(d.av); }

    // Daily #1 starts on this date (UTC). Keep it the same as launchDate in js/config.js.
    function dayStart(d) { return timestamp.date(2026, 10, 26) + duration.value(d - 1, 'd'); }
    // A day's leaderboard is open from when the first time zone starts it
    // until every time zone has finished it.
    function openFor(d) {
      return request.time > dayStart(d) - duration.value(14, 'h')
          && request.time < dayStart(d) + duration.value(38, 'h');
    }

    // One daily result per player per day. Results can't be changed later.
    // Every player posts one (name "" until they pick a name), so counts and percentiles are honest.
    // The only change allowed: putting a name on your own unnamed result.
    match /scores/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'badge', 'av', 'day', 'score', 'timeMs', 'grid', 'createdAt'])
        && avOk(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day is int
        && request.resource.data.day >= 1 && request.resource.data.day <= 100000
        && id == string(request.resource.data.day) + '_' + request.auth.uid
        && (okName(request.resource.data.name) || request.resource.data.name == '')
        && okBadge(request.resource.data.badge)
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 5
        && request.resource.data.grid is string
        && request.resource.data.grid.matches('^[gyr-]{5}$')
        && request.resource.data.grid.replace('[r-]', '').size() == request.resource.data.score
        && request.resource.data.timeMs is int
        && request.resource.data.timeMs >= 20000 && request.resource.data.timeMs <= 86400000
        && request.resource.data.createdAt == request.time
        && openFor(request.resource.data.day)
        && d5ScoreOk(request.resource.data.day, request.resource.data.grid);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.name == ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'badge', 'av'])
        && avOk(request.resource.data)
        && okName(request.resource.data.name)
        && okBadge(request.resource.data.badge);
      allow delete: if false;
    }

    // Weekly league: one entry per player per week (weeks are 7 Dailies, Monday to Sunday).
    // Points, time and days must equal the player's own posted Daily scores for that week,
    // so nobody can make them up. The tier can move one step from last week's; no entry
    // last week means starting again in Bronze (tier 0).
    function scorePath(day) { return /databases/$(database)/documents/scores/$(string(day) + '_' + request.auth.uid); }
    function sc(w, i) { return exists(scorePath(w * 7 - 6 + i)) ? get(scorePath(w * 7 - 6 + i)).data.score : 0; }
    function tm(w, i) { return exists(scorePath(w * 7 - 6 + i)) ? get(scorePath(w * 7 - 6 + i)).data.timeMs : 0; }
    function pl(w, i) { return exists(scorePath(w * 7 - 6 + i)) ? 1 : 0; }
    function okWeek(d) {
      let w = d.week;
      return d.pts == sc(w, 0) + sc(w, 1) + sc(w, 2) + sc(w, 3) + sc(w, 4) + sc(w, 5) + sc(w, 6)
          && d.timeMs == tm(w, 0) + tm(w, 1) + tm(w, 2) + tm(w, 3) + tm(w, 4) + tm(w, 5) + tm(w, 6)
          && d.days == pl(w, 0) + pl(w, 1) + pl(w, 2) + pl(w, 3) + pl(w, 4) + pl(w, 5) + pl(w, 6);
    }
    function lastWeek(w) { return /databases/$(database)/documents/league/$(string(w - 1) + '_' + request.auth.uid); }
    function okTier(w, t) {
      return t is int && t >= 0 && t <= 4
          && (exists(lastWeek(w)) ? (t >= get(lastWeek(w)).data.tier - 1 && t <= get(lastWeek(w)).data.tier + 1) : t == 0);
    }
    match /league/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'badge', 'week', 'tier', 'pts', 'timeMs', 'days', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.week is int
        && request.resource.data.week >= 1 && request.resource.data.week <= 20000
        && id == string(request.resource.data.week) + '_' + request.auth.uid
        && okName(request.resource.data.name)
        && okBadge(request.resource.data.badge)
        && (resource == null ? okTier(request.resource.data.week, request.resource.data.tier) : request.resource.data.tier == resource.data.tier)
        && okWeek(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Friend groups: anyone with the code can read and join. Members can only add,
    // rename or remove themselves.
    function okGroupName(n) { return n is string && n.size() >= 2 && n.size() <= 24; }
    match /groups/{code} {
      allow read: if true;
      allow create: if signedIn()
        && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'createdAt'])
        && okGroupName(request.resource.data.name)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members is map
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && okName(request.resource.data.members[request.auth.uid])
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members.size() <= 50
        && (!(request.auth.uid in request.resource.data.members) || okName(request.resource.data.members[request.auth.uid]));
      allow delete: if false;
    }

    // Player saves: each player's game lives in their own account (anonymous, or Google once they sign in).
    // Only that player can read, write or delete it. rev goes up by one with every save, so a device that
    // loaded an older copy can't overwrite newer progress from another device.
    match /players/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'xp', 'rev', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 300000
        && request.resource.data.xp is int && request.resource.data.xp >= 0
        && request.resource.data.rev is int
        && request.resource.data.rev == (resource == null ? 1 : resource.data.rev + 1)
        && request.resource.data.updatedAt == request.time;
    }

    // Old cloud saves (retired): progress backed up under a private 12-letter save code. Players can still
    // restore from one into their account, and moving the game to a new web address writes one.
    // Knowing the code is what lets you read or update it (codes can't be listed). XP can
    // never go down, so an older copy on another device can't overwrite newer progress.
    match /saves/{code} {
      allow get: if code.matches('^[A-Z2-9]{12}$');
      allow list, delete: if false;
      allow create, update: if signedIn()
        && code.matches('^[A-Z2-9]{12}$')
        && request.resource.data.keys().hasOnly(['data', 'xp', 'stamp', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 300000
        && request.resource.data.xp is int && request.resource.data.xp >= 0
        && request.resource.data.stamp is int
        && request.resource.data.updatedAt == request.time
        && (resource == null || request.resource.data.xp >= resource.data.xp);
    }

    // Live rooms: one link, friends playing the same cases at the same time. mode: 'race' (when missing), 'partners'
    // (two players share each case) or 'night' (Story Night: story is the nights/{id} the room plays, '' until picked).
    // A Story Night can also play a story the host made in "Write a case": story is then "u-" + a hash, and pack holds
    // the story's link code (up to 12,000 characters). Every phone checks the story itself before playing it.
    // Rooms aren't listed anywhere: you need the code. The host starts the room and moves it on;
    // a player in the room can move a stuck round on by one (the host's tab may have closed).
    // Each player writes only their own entry: their name, their answers and their score.
    function okStory(s) { return s is string && s.size() <= 40; }
    function okPack(p) { return p is string && p.size() <= 12000; }
    function inRoom(code) { return exists(/databases/$(database)/documents/rooms/$(code)/players/$(request.auth.uid)); }
    match /rooms/{code} {
      allow read: if true;
      allow create: if signedIn()
        && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['host', 'hostName', 'seed', 'season', 'state', 'round', 'rounds', 'roundAt', 'createdAt', 'mode', 'story'])
        && (!('mode' in request.resource.data) || request.resource.data.mode in ['race', 'partners', 'night'])
        && (!('story' in request.resource.data) || (request.resource.data.get('mode', '') == 'night' && okStory(request.resource.data.story)))
        && request.resource.data.host == request.auth.uid
        && okName(request.resource.data.hostName)
        && request.resource.data.seed is string && request.resource.data.seed.size() >= 4 && request.resource.data.seed.size() <= 40
        && request.resource.data.season is int && request.resource.data.season >= 1 && request.resource.data.season <= 2000
        && request.resource.data.state == 'lobby' && request.resource.data.round == 0
        && request.resource.data.rounds is int && request.resource.data.rounds >= 1 && request.resource.data.rounds <= 10
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.resource.data.state in ['lobby', 'play', 'end']
        && request.resource.data.round is int && request.resource.data.round >= 0 && request.resource.data.round <= request.resource.data.rounds
        && request.resource.data.seed is string && request.resource.data.seed.size() >= 4 && request.resource.data.seed.size() <= 40
        && (
          (resource.data.host == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'round', 'roundAt', 'seed', 'story', 'pack'])
            && (!('story' in request.resource.data) || (resource.data.get('mode', '') == 'night' && okStory(request.resource.data.story)))
            && (!('pack' in request.resource.data) || (resource.data.get('mode', '') == 'night' && okPack(request.resource.data.pack))))
          || (inRoom(code) && resource.data.state == 'play'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'round', 'roundAt'])
            && ((request.resource.data.state == 'play' && request.resource.data.round == resource.data.round + 1)
              || (request.resource.data.state == 'end' && request.resource.data.round == resource.data.round)))
        );
      allow delete: if false;
      match /players/{uid} {
        allow read: if true;
        allow create, update: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'score', 'ans', 'joinedAt', 'at', 'seen'])
          && (!('seen' in request.resource.data) || request.resource.data.seen is bool)
          && okName(request.resource.data.name)
          && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 2000
          && request.resource.data.ans is map && request.resource.data.ans.size() <= 10;
        allow delete: if signedIn() && uid == request.auth.uid;
      }
    }

    // Story Night: stories made for friends' rooms. The admin desk publishes them with the Admin SDK (which skips
    // these rules). Everything is public, answers too: friends' rooms check answers on each player's phone.
    match /nights/{id} {
      allow read: if true;
      allow write: if false;
      match /{sub}/{n} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Season scoreboard: one entry per player per season. A season is 4 league weeks, and Season 1 is
    // weeks 3 to 6 (Daily #15 to #42; keep in step with SEASON_ONE in js/engine.js). Points, time and days
    // must equal the player's own league entries for those weeks, which are checked against their Daily scores.
    function lgPath(w) { return /databases/$(database)/documents/league/$(string(w) + '_' + request.auth.uid); }
    function lg(w) { return exists(lgPath(w)) ? get(lgPath(w)).data : { 'pts': 0, 'timeMs': 0, 'days': 0 }; }
    function okSeason(d) {
      let w = d.season * 4 - 1;
      let a = lg(w);
      let b = lg(w + 1);
      let c = lg(w + 2);
      let e = lg(w + 3);
      return d.pts == a.pts + b.pts + c.pts + e.pts
          && d.timeMs == a.timeMs + b.timeMs + c.timeMs + e.timeMs
          && d.days == a.days + b.days + c.days + e.days;
    }
    match /seasons/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'badge', 'season', 'pts', 'timeMs', 'days', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.season is int
        && request.resource.data.season >= 1 && request.resource.data.season <= 2000
        && id == string(request.resource.data.season) + '_' + request.auth.uid
        && okName(request.resource.data.name)
        && okBadge(request.resource.data.badge)
        && okSeason(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ---------- Season ladder: league points (LP) from each Daily ----------
    // One entry per player per season. Every write adds exactly one new day, scored from the player's own posted
    // Daily grid (g +30, y +20, a wrong answer at case 1-5 costs 50/40/30/20/10 except in Bronze), or only changes
    // the name, face or badge. Keep the numbers in step with LADDER in js/engine.js. Season s = Dailies 15+28(s-1) to 42+28(s-1).
    function sFirst(s) { return 15 + (s - 1) * 28; }
    function tierOf(lp) { return lp >= 2800 ? 4 : lp >= 1800 ? 3 : lp >= 1000 ? 2 : lp >= 400 ? 1 : 0; }
    function cnt(g, re) { return g.size() - g.replace(re, '').size(); }
    function lost(g) {
      return (g.matches('^r.*') ? 50 : 0) + (g.matches('^.r.*') ? 40 : 0) + (g.matches('^..r.*') ? 30 : 0)
        + (g.matches('^...r.*') ? 20 : 0) + (g.matches('^....r.*') ? 10 : 0);
    }
    function dayPts(g, tier) { return cnt(g, 'g') * 30 + cnt(g, 'y') * 20 - (tier > 0 ? lost(g) : 0); }
    function gridOf(d) { return get(/databases/$(database)/documents/scores/$(string(d) + '_' + request.auth.uid)).data.grid; }
    function prevLadder(s) { return /databases/$(database)/documents/ladder/$(string(s - 1) + '_' + request.auth.uid); }
    function startLp(s) { return exists(prevLadder(s)) ? [0, 0, 400, 1000, 1800][get(prevLadder(s)).data.tier] : 0; }
    function okLadder(d, id) {
      return signedIn()
        && d.keys().hasAll(['uid', 'name', 'badge', 'season', 'lp', 'tier', 'days', 'solved', 'cases', 'fails', 'rate', 'failRate', 'last', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'name', 'badge', 'av', 'season', 'lp', 'tier', 'days', 'solved', 'cases', 'fails', 'rate', 'failRate', 'last', 'updatedAt'])
        && d.uid == request.auth.uid
        && d.season is int && d.season >= 1 && d.season <= 2000
        && id == string(d.season) + '_' + request.auth.uid
        && okName(d.name) && okBadge(d.badge) && avOk(d)
        && d.last is int && d.last >= sFirst(d.season) && d.last <= sFirst(d.season) + 27
        && d.updatedAt == request.time;
    }
    // n: the new entry. base*: the entry before this day (all 0 and the season's start LP for a first entry).
    function okStep(n, baseLp, baseTier, solved, cases, days, fails) {
      let g = gridOf(n.last);
      let lp = baseLp + dayPts(g, baseTier);
      return n.lp == (lp > 0 ? lp : 0) && n.tier == tierOf(n.lp)
        && n.solved == solved + cnt(g, '[gy]') && n.cases == cases + 5 && n.days == days + 1
        && n.fails == fails + (g.matches('.*r.*') ? 1 : 0)
        && n.rate == int(n.solved * 1000 / n.cases) && n.failRate == int(n.fails * 1000 / n.days);
    }
    match /ladder/{id} {
      allow read: if true;
      allow create: if okLadder(request.resource.data, id)
        && okStep(request.resource.data, startLp(request.resource.data.season), tierOf(startLp(request.resource.data.season)), 0, 0, 0, 0);
      allow update: if okLadder(request.resource.data, id) && resource.data.uid == request.auth.uid
        && ((request.resource.data.last > resource.data.last
              && okStep(request.resource.data, resource.data.lp, resource.data.tier, resource.data.solved, resource.data.cases, resource.data.days, resource.data.fails))
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'av', 'badge', 'updatedAt']));
      allow delete: if false;
    }

    // ---------- Friends: up to 8, added with a 6-letter friend code ----------
    // fcodes/{code} points a code at its owner (claimed once). friends/{uid} is the owner's list. A request, an accept or a
    // remove goes into the other player's inbox as one doc per sender; only the receiver reads and clears it. The game
    // only acts on an "accept" from someone the player asked, so nobody can add themselves to a list.
    function okCode(c) { return c is string && c.matches('^[A-Z2-9]{6}$'); }
    function okWho(n) { return okName(n) || n == ''; }
    match /fcodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && okCode(code)
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /friends/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['code', 'name', 'av', 'list', 'updatedAt'])
        && okCode(request.resource.data.code) && okWho(request.resource.data.name) && avOk(request.resource.data)
        && request.resource.data.list is list && request.resource.data.list.size() <= 8
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      match /inbox/{from} {
        allow read, delete: if signedIn() && uid == request.auth.uid;
        allow create: if signedIn() && from == request.auth.uid && from != uid
          && request.resource.data.keys().hasOnly(['from', 'name', 'av', 'kind', 'at'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.kind in ['ask', 'accept', 'remove']
          && okWho(request.resource.data.name) && avOk(request.resource.data)
          && request.resource.data.at == request.time;
        allow update: if false;
      }
    }

    // ---------- Daily 5: one story a day in five connected cases ----------
    // Stories are uploaded ahead of time by the admin tool (Admin SDK, which skips these rules) and open on their day.
    // The day turns over at midnight India time (UTC+5:30) for everyone. A day's story stays playable until 6 AM IST
    // the next morning; after that everything except the answer keys is public, as the archive.
    function istStart(d) { return dayStart(d) - duration.value(330, 'm'); }
    function d5Open(d) { return request.time < istStart(d + 1) + duration.value(6, 'h'); }
    function runPath(d) { return /databases/$(database)/documents/d5runs/$(string(d) + '_' + request.auth.uid); }
    function hasRun(d) { return signedIn() && exists(runPath(d)); }
    function myRun(d) { return get(runPath(d)).data; }
    function reds(g) { return g.size() - g.replace('r', '').size(); }
    // Case n opens when it's the player's next case and they haven't run out of tries, or once they've played it.
    function canSee(r, n) { return n <= r.grid.size() || (n == r.grid.size() + 1 && reds(r.grid) < r.strikes); }

    match /d5/{day} {
      allow get: if request.time >= istStart(int(day));
      allow list, write: if false;
      match /cases/{n} {
        allow get: if request.time >= istStart(int(day)) && (!d5Open(int(day)) || (hasRun(int(day)) && canSee(myRun(int(day)), int(n))));
        allow list, write: if false;
      }
      // the answer and what it proves: once the player has committed their own answer to that case
      match /reveals/{n} {
        allow get: if request.time >= istStart(int(day)) && (!d5Open(int(day)) || (hasRun(int(day)) && ('c' + n) in myRun(int(day)).picks));
        allow list, write: if false;
      }
      match /hunch/{n} {
        allow get: if request.time >= istStart(int(day)) && (!d5Open(int(day)) || (hasRun(int(day)) && myRun(int(day)).hunch == int(n)));
        allow list, write: if false;
      }
      // the full story: at once for players who played all five, at the next midnight for those who ran out of tries
      match /end/{doc} {
        allow get: if request.time >= istStart(int(day)) && (!d5Open(int(day)) || (hasRun(int(day))
          && (myRun(int(day)).grid.size() == 5 || (reds(myRun(int(day)).grid) >= myRun(int(day)).strikes && request.time >= istStart(int(day) + 1)))));
        allow list, write: if false;
      }
    }
    // The answer keys. No player can ever read them; only the rules below look inside.
    match /d5keys/{day} {
      allow read, write: if false;
    }

    // A player's run through a day's story. Each answer takes two writes: commit the pick (it can never change after
    // that), then resolve it once the reveal is open. Resolving checks the pick against the key, so the run, and the
    // score posted from it, can't be faked, and no one can try answers until one is accepted.
    function d5Key(d, c) { return get(/databases/$(database)/documents/d5keys/$(string(d))).data.get(c, null); }
    function d5Commit() {
      let r = resource.data;
      let q = request.resource.data;
      let c = 'c' + string(r.grid.size() + 1);
      let p = q.picks.get(c, null);
      return q.diff(r).affectedKeys().hasOnly(['picks'])
        && r.grid.size() < 5 && reds(r.grid) < r.strikes
        && !(c in r.picks)
        && q.picks.diff(r.picks).affectedKeys().hasOnly([c])
        && p is map && p.keys().hasOnly(['s', 'p', 'at'])
        && p.s is string && p.s.size() <= 120 && p.p is string && p.p.size() <= 60
        && p.at == request.time;
    }
    function d5Resolve() {
      let r = resource.data;
      let q = request.resource.data;
      let n = r.grid.size() + 1;
      let c = 'c' + string(n);
      let p = r.picks.get(c, null);
      let k = d5Key(r.day, c);
      let right = p != null && k != null && p.s == k.s && p.p in k.proofs;
      return q.diff(r).affectedKeys().hasOnly(['grid'])
        && p != null && k != null
        && q.grid == r.grid + (right ? (r.hunch == n ? 'y' : 'g') : 'r');
    }
    function d5Hunch() {
      let r = resource.data;
      let q = request.resource.data;
      let n = r.grid.size() + 1;
      return q.diff(r).affectedKeys().hasOnly(['hunch'])
        && r.hunch == 0 && q.hunch == n && n <= 5
        && !(('c' + string(n)) in r.picks)
        && reds(r.grid) < r.strikes;
    }
    match /d5runs/{id} {
      allow get: if signedIn() && id.split('_')[1] == request.auth.uid;
      allow list, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'day', 'picks', 'grid', 'strikes', 'hunch', 'startedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day is int
        && id == string(request.resource.data.day) + '_' + request.auth.uid
        && request.resource.data.picks == {}
        && request.resource.data.grid == ''
        && request.resource.data.hunch == 0
        && request.resource.data.strikes == get(/databases/$(database)/documents/d5/$(string(request.resource.data.day))).data.strikes
        && request.time >= istStart(request.resource.data.day)
        && request.time < istStart(request.resource.data.day + 1)
        && request.resource.data.startedAt == request.time;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && d5Open(resource.data.day)
        && (d5Commit() || d5Resolve() || d5Hunch());
    }
    // On a day with a story, the Daily score must be the player's finished run (grid padded with - for locked cases).
    function d5ScoreOk(day, grid) {
      let rp = runPath(day);
      return !exists(/databases/$(database)/documents/d5keys/$(string(day)))
        || (exists(rp) && (get(rp).data.grid.size() == 5 || reds(get(rp).data.grid) >= get(rp).data.strikes)
          && grid.matches(get(rp).data.grid + '-*'));
    }

    // Endless mode: each player keeps their best run. It can only go up.
    match /endless/{userId} {
      allow read: if true;
      allow create, update: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'badge', 'best', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && okName(request.resource.data.name)
        && okBadge(request.resource.data.badge)
        && request.resource.data.best is int
        && request.resource.data.best >= 1 && request.resource.data.best <= 2000
        && request.resource.data.updatedAt == request.time
        && (resource == null || request.resource.data.best > resource.data.best);
      allow delete: if false;
    }
  }
}
